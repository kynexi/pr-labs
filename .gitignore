.idea/**/shelf/
.idea/**/contentModel.xml
.idea/**/dictionaries
.idea/**/httpRequests/
.idea/**/dataSources/
.idea/**/dataSources.local.xml

# --- VS Code / Visual Studio ---
.vs/
.vscode/*
!.vscode/settings.json

# --- macOS ---
.DS_Store

# --- Python (charts) ---
__pycache__/
.venv/
